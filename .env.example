# 统一服务环境变量示例。复制为 .env 并填值(.env 不要提交 git)。

# LLM(统一一套,v3 与 RetainPDF 共用)——必填
LLM_API_KEY=xxxxxxxxxxxxxxxxxx
LLM_MODEL=xxxxxxx
LLM_BASE_URL=xxxxxxxxxxxxxx

# OCR 来源(RetainPDF 扫描页用)
# cloud = 云端 PaddleOCR；local = 本地部署 OCR
RETAIN_OCR_PROVIDER=cloud

# 云端 PaddleOCR。RETAIN_OCR_PROVIDER=cloud 且有扫描件时需要 token
RETAIN_PADDLE_TOKEN=xxxxxxxxxxxxxxx
# 可选: 默认就是 PaddleOCR-VL-1.6；API 地址通常不用改
# RETAIN_PADDLE_API_URL=
# RETAIN_PADDLE_MODEL=PaddleOCR-VL-1.6

# 本地 OCR：新版镜像默认内置 CPU PaddleOCR PP-StructureV3，无需独立 OCR 服务或 token。
# 在 Dify/API 中选择 local 即可；OCR 仍需 text_based=false。
# 如需连接以前单独部署的 PaddleX /layout-parsing 服务，再启用下面两项：
# RETAIN_LOCAL_OCR_BACKEND=service
# RETAIN_LOCAL_OCR_URL=http://host.docker.internal:8080
# 可选: 本地 PaddleX 服务较慢或页面较多时可调大超时
# RETAIN_LOCAL_OCR_TIMEOUT_SECONDS=1800
# RETAIN_OCR_RAW_PROVIDER=paddle

# 可选: PaddleOCR-VL 把文字截图识别成 image 块时,自动裁剪该区域二次 OCR 拆成小文本块
# 默认开启；如遇到云端调用成本/耗时问题可设为 0
# RETAIN_PADDLE_IMAGE_REOCR=1
RETAIN_PADDLE_IMAGE_REOCR_MAX_BLOCKS=200
# RETAIN_PADDLE_IMAGE_REOCR_MIN_AREA_RATIO=0.015
# RETAIN_PADDLE_IMAGE_REOCR_MIN_TEXT_CHARS=12

# 工作目录与清理
WORK_ROOT=/data
RETENTION_SECONDS=3600

# 分类阈值(可调)
MIN_TEXT_CHARS=10
IMAGE_COVER_THRESHOLD=0.45
IMAGE_DOMINANT_TEXT_CHARS=300

# RetainPDF 子进程超时(秒)
RETAIN_TIMEOUT=3600

# 服务端口
PORT=8040

# 自动按目标语言选字体：意大利语/德语等用 Noto Serif，中文用对应 CJK 字体。
RETAIN_PDF_TYPST_FONT_FAMILY=auto
# 可选：拉丁语言使用无衬线字体
# RETAIN_PDF_LATIN_FONT_FAMILY=Noto Sans
# 手动使用其他字体时同时设置其 Typst family、匹配的常规字体文件和字体目录。
# RETAIN_PDF_TYPST_FONT_FAMILY=Your Font Family
# RETAIN_PDF_FONT_PATH=/path/to/YourFont-Regular.ttf
# RETAIN_PDF_TYPST_FONT_DIRS=/path/to/fonts
